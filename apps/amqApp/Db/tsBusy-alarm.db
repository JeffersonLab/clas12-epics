record(calc,"$(P):alarm") {
    field(INPA,"B_IPM2C21A:rms CPP")
    field(INPB,"B_IPM2C21A:mean CPP")
    field(INPC,"B_IPM2C21A:rms.HIGH")
    field(INPD,"B_IPM2C21A:mean.LOW")
    field(INPE,"$(P):rms CPP")
    field(INPF,"$(P):mean CPP")
    field(INPG,"$(P):rms.HIGH")
    field(INPH,"$(P):mean.LOW")
    field(INPI,"IPM2C21A CPP")
    field(INPJ,"B_DAQ:coda_status CPP")
    field(CALC,"(A<C&&B>D&&I>D)&&(E>G||F<H)")
# This would disable the indicators before starting the run:
#&&J=1")
    field(HIGH,"1")
    field(HSV,"MAJOR")
}

