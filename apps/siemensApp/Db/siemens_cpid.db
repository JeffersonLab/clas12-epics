record(stringout, "$(P)$(R=)NAME") {
    field(DESC, "Name of controlled value")
    field(OMSL, "supervisory")
    field(VAL, "itov7out")
    field(OUT, "$(P)$(R=)ICVAL.INP CA")
    info(autosaveFields_pass0, "VAL")
}
record(ai, "$(P)$(R=)ICVAL") {
    field(SCAN, "1 second")
    field(INP, "")
    field(FLNK, "$(P)$(R=)OCVAL PP")
}
record(ao, "$(P)$(R=)OCVAL") {
    field(OMSL, "closed_loop")
    field(DOL, "$(P)$(R=)ICVAL")
    field(OUT, "$(P)$(R=)CVAL PP")
}
record(ao, "$(P)$(R=)CVAL") {
    field(DESC, "controlled value")
    field(DTYP, "s7nodave")
    field(OUT,  "@$(PLCID) $(CVAL) float")
}

record(ai, "$(P)$(R=)OVAL") {
    field(DESC, "output value")
    field(DTYP, "s7nodave")
    field(INP,  "@$(PLCID) $(OVAL) float")
    field(EGU,  "%")
    field(PREC, "2")
    field(SCAN, "I/O Intr")
    info(autosaveFields_pass0, "HIGH HIHI LOW LOLO HSV HHSV LSV LLSV")
}
record(ao, "$(P)$(R=)OVAL:SET") {
    field(DESC, "output value")
    field(DTYP, "s7nodave")
    field(OUT,  "@$(PLCID) $(OVAL) float")
    field(EGU,  "%")
    field(PREC, "2")
    field(SCAN, "Passive")
}
